    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const x = item.json;\n\n  const toNumber = (value) => {\n    if (value === null || value === undefined || value === '') {\n      return null;\n    }\n    const n = Number(value);\n    return Number.isFinite(n) ? n : null;\n  };\n\n  const toInteger = (value) => {\n    const n = toNumber(value);\n    return n === null ? null : Math.trunc(n);\n  };\n\n  return {\n    json: {\n      ...x,\n      year: toInteger(x.year),\n      extensive: toInteger(x.extensive),\n      OperatingrevenueTurnover: toNumber(x.OperatingrevenueTurnover),\n      TotalassetsthUSD: toNumber(x.TotalassetsthUSD),\n      Numberofemployees: toNumber(x.Numberofemployees)\n    }\n  };\n});"
      },
