    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO f_mreid (\n    origin_iso3,\n    destination_iso3,\n    year,\n    sector_code,\n    affiliate_count,\n    operating_revenue_thousand_usd,\n    employees,\n    total_assets_thousand_usd\n)\n\nSELECT\n    iso3_o,\n    iso3_d,\n    year,\n    CAST(naics2 AS UNSIGNED),\n    SUM(extensive),\n    SUM(operating_revenue),\n    SUM(employees),\n    SUM(total_assets)\n\nFROM mreid_data\n\nGROUP BY\n    iso3_o,\n    iso3_d,\n    year,\n    naics2\n\nON DUPLICATE KEY UPDATE\n    affiliate_count = VALUES(affiliate_count),\n    operating_revenue_thousand_usd = VALUES(operating_revenue_thousand_usd),\n    employees = VALUES(employees),\n    total_assets_thousand_usd = VALUES(total_assets_thousand_usd);\n",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        480,
        1136
      ],
      "id": "5aa30f79-40f6-494c-9b9b-0b4802fc98ae",
      "name": "Leer datos mreid",
      "credentials": {
        "mySql": {
          "id": "6fyCGFTjIb2DPRNd",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS f_mreid (\n  \n    origin_iso3 VARCHAR(3) NOT NULL,\n    destination_iso3 VARCHAR(3) NOT NULL,\n    year INT NOT NULL,\n    sector_code INT NOT NULL,\n\n    affiliate_count INT DEFAULT NULL,\n    operating_revenue_thousand_usd DECIMAL(15,2) DEFAULT NULL,\n    employees INT DEFAULT NULL,\n    total_assets_thousand_usd DECIMAL(15,2) DEFAULT NULL,\n\n    PRIMARY KEY (origin_iso3, destination_iso3, year, sector_code),\n\n    FOREIGN KEY (origin_iso3)\n        REFERENCES countries(iso3),\n\n    FOREIGN KEY (destination_iso3)\n        REFERENCES countries(iso3),\n\n    FOREIGN KEY (year)\n        REFERENCES dim_dates(year),\n\n    FOREIGN KEY (sector_code)\n        REFERENCES dim_sectors(sector_code)\n) ENGINE=InnoDB;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        240,
        1136
      ],
      "id": "9633004b-f728-4a3d-8732-62d2725e333e",
      "name": "Crear tabla sectores",
