      ],
      "id": "b2bff76e-a910-4705-ad29-90959534bb3a",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nreturn rows\n  .filter(item =>\n    item.json.TIME_PERIOD &&\n    item.json.OBS_VALUE &&\n    item.json.OBS_STATUS === 'A'\n  )\n  .map(item => {\n    const usdPerEur = Number(item.json.OBS_VALUE);\n\n    return {\n      json: {\n        rate_date: item.json.TIME_PERIOD,\n        usd_per_eur: usdPerEur,\n        source: 'European Central Bank'\n      }\n    };\n  });\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        864
      ],
      "id": "69fb8ce5-7c6e-45e6-a69c-5411abd58eb7",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO currency_api (\n    rate_date,\n    usd_per_eur,\n    source\n)\nVALUES (\n    '{{$json.rate_date}}',\n    {{$json.usd_per_eur}},\n    '{{$json.source}}'\n)\nON DUPLICATE KEY UPDATE\n    usd_per_eur = VALUES(usd_per_eur),\n    source = VALUES(source);",
        "options": {}
      },
