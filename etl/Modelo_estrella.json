      "id": "66dde67a-c2c2-478e-bf8b-82588d83e5a8",
      "name": "Get ECB exchange rates"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
